# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 内置 CJK 子集（中文支持）
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
# 第五轮内存修复：LVGL 改用标准 C 库 malloc，不再预留独立静态内存池。
# 内置池(lv_mem_core_builtin.c 的 work_mem_int)会固定占掉 32KB .bss，
# 该静态区与系统堆互不相通；本应用 UI 仅少量控件、无画布，该池大半闲置，
# 却把 NimBLE 主机初始化可用的内部 8BIT 堆压到临界，导致 ble_hs.c 的
# ble_gatts_init()/ble_gattc_init() 中约 64 字节的 calloc 失败
# (ENOMEM → SYSINIT_PANIC_ASSERT(rc == 0) 崩溃重启)。
# 改为按需从系统堆分配后，约 30KB RAM 归还堆，供 Wi-Fi/TLS 复用。
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# 情侣互动需要同时广播和扫描，启用四个角色
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# GATT 写入回调在 NimBLE host 任务栈上同步执行 cJSON 解析（栈上 json_buf[256]）
# 与 NVS 提交（含 flash 写，调用链深）。默认 4096 会栈溢出触发 panic 重启，
# 表现为 App 写入配对数据时设备断开连接，故扩到 8192。
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# Wi-Fi 扫描结果（最多约 13 条）要一次读回，默认 256 的 ATT MTU 装不下，
# 提到 512；App 侧读取扫描特征时也会请求 512。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
# NimBLE 缓冲池裁剪（第四轮建立、第五轮加深）：
# esp_wifi_init 静态占用约 40KB 后，BT controller init/enable 的分散小分配
# 会把剩余最大连续块切碎；此时 hci init 中 MSYS_2(24×320≈7.5KB) 与
# ACL 池(24×~300B≈7KB) 的单笔连续分配失败，日志表现为 "hci inits failed"。
# 本应用仅 1 个连接、GATT 小数据（凭据下发/状态同步），故持续下调：
# 12/12/20 → 8/8/12 → 6/6/8。单连接 + MTU 512 的短报文完全够用，
# 腾出的堆直接用于 AI 语音 TLS 握手（mbedtls_ssl_setup 的分配曾失败）。
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8

# --- mbedTLS（AES 加密需要）---
CONFIG_MBEDTLS_CIPHER_C=y
CONFIG_MBEDTLS_AES_C=y

# --- Wi-Fi（App 经 BLE 下发凭据，设备以 STA 身份连接）---
# 未配网的设备不启动射频；一旦下发凭据即启动 STA。
CONFIG_ESP_WIFI_ENABLED=y
# 心跳广播(BLE) 与 Wi-Fi STA 共用 2.4G 射频，必须开启软件共存，
# 否则两者互相抢占会导致心跳丢包或 Wi-Fi 握手失败。
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- 内存（无 PSRAM，Wi-Fi + BLE + TLS 需同时驻留）---
# HTTPS 走证书包校验，不做 insecure 连接
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# TLS 记录长度默认 16KB；AI 对话的响应是按块读取的，缩到 4KB 可省下约 12KB 堆。
# 注意：4KB 是 mbedtls 单条记录上限，不影响总响应长度。
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=1024
# TLS 记录缓冲按需分配：握手/收发结束后释放 in/out 缓冲，给 Wi-Fi 发送腾出
# 连续块（本板 TLS 连接建立后只剩 8KB，Wi-Fi 分配 1.6KB TX 缓冲都会失败）。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# 握手完成后不再保留对端证书，省 1~2KB
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# Wi-Fi 缓冲裁剪：默认值(静态RX 10 + 动态RX/TX 32×2 + AMPDU 聚合)在 NimBLE+LVGL+音频
# 全部就绪后已把空闲堆压到约 15KB，esp_wifi_init 分配 10 个静态 RX buffer 直接失败
# (esf_buf_setup_static: alloc eb fail)，连带 AI 对话初始化 NO_MEM。
# 本应用 Wi-Fi 仅用于 AI 的 HTTPS 小包请求，减半缓冲并关闭 AMPDU 聚合无吞吐损失。
# 第五轮再降到 3：3×1600=4.8KB，TLS 握手期间 RX 突发仍能覆盖；
# 再腾 1.6KB 给 TLS 握手（该握手会把空闲堆几乎吃干）。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
# 动态 RX 池从 16 降到 4：每块约 1.6KB。TLS 握手后最大连续块只剩 4~5KB，
# 而 Wi-Fi 收发需要的块更大，日志里已出现 `wifi:m f null` / `wifi:mem fail`
# （分配失败导致上行停滞）。
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
# TX 池 4：保留足够的一次上行突发；TTS 已移除，不再需要为 16KB TLS 记录让路。
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# TCP 窗口：TTS 已移除，恢复默认值以提升 ASR 上传吞吐。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
# 发行版优化等级：-O2（性能优先）。ESP-IDF 默认 -Og 是给调试用的，
# 语音识别上传、TLS 与 LVGL 刷新在 -O2 下明显更快。断言保持开启，
# 避免把潜在的越界/空指针问题静默成未定义行为。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
